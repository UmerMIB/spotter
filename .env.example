# Django Settings
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS (for split frontend/backend development)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Routing & Weather Config
TRUCK_MAX_SPEED_MPH=65.0
WEATHER_COVERAGE_THRESHOLD_PCT=90.0
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
PHOTON_BASE_URL=https://photon.komoot.io/api
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
HTTP_USER_AGENT=SpotterWeatherTruckRouting/1.0 (contact@spotter.ai)
